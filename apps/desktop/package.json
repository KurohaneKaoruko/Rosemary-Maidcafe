{
  "name": "@rosemary/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Rosemary MaidCafe — Tauri desktop wrapper. The web app (apps/web) is the shared codebase.",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:web": "pnpm --filter @rosemary/web build",
    "dev:web": "pnpm --filter @rosemary/web dev",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs patch --dry-run",
    "gen:maid-manifest": "node scripts/generate-maid-image-manifest.mjs"
  },
  "dependencies": {
    "@rosemary/web": "workspace:*",
    "@tauri-apps/api": "2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.0",
    "@tauri-apps/plugin-dialog": "2.3.2",
    "@tauri-apps/plugin-fs": "2.4.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.0",
    "@tauri-apps/plugin-http": "2.5.1",
    "@tauri-apps/plugin-notification": "2.3.0",
    "@tauri-apps/plugin-os": "2.3.0",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-shell": "2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.7.1",
    "playwright": "^1.58.2",
    "typescript": "^5.0.0"
  }
}
